// Generated into the build directory by CMake (absolute icon path).
#include <winres.h>

1 ICON "@CMAKE_CURRENT_SOURCE_DIR@/app_icon.ico"

#ifdef FIV_RC_MANIFEST
1 RT_MANIFEST "@CMAKE_CURRENT_SOURCE_DIR@/src/app/app.manifest"
#endif

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Fast Image Viewer"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "ProductName", "Fast Image Viewer"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
            VALUE "OriginalFilename", "FastImageViewer.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
